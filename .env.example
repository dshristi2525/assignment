# Copy to .env (git-ignored) or export these in your shell. Nothing here is required:
# with LLM_PROVIDER=none the pipeline uses a deterministic fallback explanation.

LLM_PROVIDER=none          # none | ollama | groq | openrouter | openai_compat
LLM_TIMEOUT_SECONDS=30

# --- Local model via Ollama (free, nothing leaves your machine) ---
#   ollama serve && ollama pull llama3.2
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.2

# --- Hosted free-tier endpoints (any OpenAI-compatible API) ---
# LLM_PROVIDER=groq
# LLM_API_KEY=<your key - never commit it>
# LLM_MODEL=<a model id available on your account>

# --- Fully custom endpoint ---
# LLM_PROVIDER=openai_compat
# LLM_BASE_URL=http://localhost:1234/v1
# LLM_MODEL=<model id>
